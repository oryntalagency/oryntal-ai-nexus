MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oryntal

# Object storage for uploaded product/blog media (images & videos).
# When set, POST bytes here and expect { url } back. When unset in dev,
# uploads fall back to local files under public/uploads/.
STORAGE_UPLOAD_ENDPOINT=
STORAGE_API_KEY=

# Secret used to sign the httpOnly admin session JWT (HS256, node:crypto).
# In dev a random in-memory fallback is used when this is unset.
ADMIN_SESSION_SECRET=