MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oryntal

# Object storage for uploaded product/blog media (images & videos) via Vercel Blob.
# Create a Blob store in the Vercel dashboard (Storage tab) and link it to this
# project, then add its read/write token here (or run `vercel env pull` after
# linking). Vercel injects BLOB_READ_WRITE_TOKEN into serverless functions
# automatically once the store is linked — the value is what put() authenticates
# with. Upload size limits: 10 MB for images, 100 MB for video.
BLOB_READ_WRITE_TOKEN=

# Secret used to sign the httpOnly admin session JWT (HS256, node:crypto).
# In dev a random in-memory fallback is used when this is unset.
ADMIN_SESSION_SECRET=

# Outbound mail for the contact form (SMTP). MAIL_USER is the authenticating
# account and MAIL_FROM is shown as the sender; enquiries are delivered to
# MAIL_TO. Leave blank to disable sending (the form then reports an error).
MAIL_HOST=smtpout.secureserver.net
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_TO=